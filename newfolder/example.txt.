<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Language Learning Hub</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <header>
        <h1>Language Learning Hub</h1>
        <nav>
            <a href="#home">Home</a>
            <a href="#lessons">Lessons</a>
            <a href="#quiz">Quiz</a>
            <a href="#progress">Progress</a>
        </nav>
    </header>
    
    <section id="home">
        <h2>Welcome!</h2>
        <p>Choose a language to start learning.</p>
        <select id="language-select">
            <option value="spanish">Spanish</option>
            <option value="french">French</option>
            <option value="german">German</option>
        </select>
        <button id="start-btn">Start Learning</button>
    </section>
    
    <section id="lessons" class="hidden">
        <h2>Lessons</h2>
        <div id="lesson-content">
            <!-- Dynamic content loaded here -->
        </div>
        <button id="next-lesson">Next Lesson</button>
    </section>
    
    <section id="quiz" class="hidden">
        <h2>Quiz</h2>
        <div id="quiz-content">
            <!-- Quiz questions here -->
        </div>
        <button id="submit-quiz">Submit</button>
        <p id="quiz-result"></p>
    </section>
    
    <section id="progress" class="hidden">
        <h2>Your Progress</h2>
        <p id="progress-display">Completed: 0 lessons</p>
    </section>
    
    <script src="script.js"></script>
</body>
</html>This is a test file